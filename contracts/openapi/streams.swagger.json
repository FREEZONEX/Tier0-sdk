{
  "openapi": "3.0.3",
  "info": {
    "title": "Tier0 OpenAPI",
    "version": "v1"
  },
  "paths": {
    "/openapi/v1/stream-requests/discover": {
      "post": {
        "description": "发现可见Stream 请求合同，只公开Stream 请求合同，不返回内部运行绑定",
        "operationId": "streamRequestDiscover",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StreamRequestDiscoverReq"
              }
            }
          },
          "required": true,
          "x-originalParamName": "body"
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamRequestDiscoverResp"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Discover Stream requests",
        "tags": [
          "Stream requests"
        ]
      }
    },
    "/openapi/v1/stream-requests/{requestCode}/describe": {
      "post": {
        "description": "读取公开Stream 请求合同，只公开Stream 请求合同，不返回内部运行绑定",
        "operationId": "streamRequestDescribe",
        "parameters": [
          {
            "in": "path",
            "name": "requestCode",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicStreamRequest"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Describe Stream request",
        "tags": [
          "Stream requests"
        ]
      }
    },
    "/openapi/v1/stream-requests/{requestCode}/invoke": {
      "post": {
        "description": "按公开合同调用Stream 请求；原始 body 为有效 UTF-8，最多 1MiB 字节；可选 idempotencyKey 解码后最多 128 UTF-8 字节，是否必填由冻结合同决定。返回 code、contractVersion、result、runID、status、replayed(boolean)，不返回内部运行绑定。结果未知返回 HTTP 504，errorCode=STREAM_REQUEST_RESULT_UNKNOWN；未知内部错误返回 HTTP 500，errorCode=STREAM_REQUEST_INTERNAL_ERROR，message 不泄漏内部异常",
        "operationId": "streamRequestInvoke",
        "parameters": [
          {
            "in": "path",
            "name": "requestCode",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StreamRequestInvokeReq"
              }
            }
          },
          "required": true,
          "x-originalParamName": "body"
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamRequestInvokeResp"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Invoke Stream request",
        "tags": [
          "Stream requests"
        ]
      }
    },
    "/openapi/v1/stream-messages/connect": {
      "post": {
        "operationId": "streamMessagesConnect",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StreamMessagesConnectReq"
              }
            }
          },
          "required": true,
          "x-originalParamName": "body"
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamMessagesConnectResp"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Connect Stream messages",
        "tags": [
          "Stream messages"
        ]
      }
    },
    "/openapi/v2/capabilities/discover": {
      "post": {
        "description": "需要有效 Workspace API Key，Body 仅接受空 JSON 对象，最大 4KiB UTF-8 字节，不接受查询参数或 Workspace 覆盖。成功响应直接为 CapabilityDiscoverResp，不包裹 code/msg/data。能力由默认关闭的公开发布开关、Workspace FeatureGate、Key 显式授权共同裁决；Stream request 能力仅报告当前发布与授权，运行可用性保持 readiness_unknown，不触发运行时探针。实际操作由后端执行安全检查，失败返回真实错误。响应允许客户端忽略未知扩展字段；版本标签不表示设备 ACK 或 npm 包版本。错误直接返回 CapabilityErrorResp 和真实 HTTP 状态，不泄漏内部异常。",
        "operationId": "PlatformV2CapabilityDiscover",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformCapabilityDiscoverResp"
                }
              }
            },
            "description": ""
          },
          "400": {
            "description": "Platform operation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformCapabilityErrorResp"
                }
              }
            }
          },
          "401": {
            "description": "Platform operation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformCapabilityErrorResp"
                }
              }
            }
          },
          "403": {
            "description": "Platform operation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformCapabilityErrorResp"
                }
              }
            }
          },
          "500": {
            "description": "Platform operation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformCapabilityErrorResp"
                }
              }
            }
          },
          "503": {
            "description": "Platform operation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformCapabilityErrorResp"
                }
              }
            }
          }
        },
        "summary": "发现当前 Workspace 的公开能力与版本合同",
        "tags": [
          "平台信息"
        ],
        "security": [
          {
            "ApiKey": []
          }
        ],
        "x-tier0-readonly": true,
        "x-tier0-destructive": false,
        "x-tier0-audience": "builder",
        "x-tier0-platform": true,
        "x-tier0-source-operation": "/openapi/v1/capabilities/discover"
      }
    }
  },
  "components": {
    "schemas": {
      "StreamRequestDiscoverReq": {
        "properties": {
          "page": {
            "description": "缺省为 1",
            "type": "integer"
          },
          "search": {
            "type": "string"
          },
          "size": {
            "description": "缺省为 20",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "StreamRequestDiscoverResp": {
        "properties": {
          "list": {
            "items": {
              "$ref": "#/components/schemas/PublicStreamRequest"
            },
            "type": "array"
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "total",
          "list"
        ],
        "type": "object"
      },
      "PublicStreamRequest": {
        "properties": {
          "code": {
            "type": "string"
          },
          "contractVersion": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "idempotency": {
            "type": "string"
          },
          "inputSchema": {
            "additionalProperties": {},
            "type": "object"
          },
          "name": {
            "type": "string"
          },
          "outputSchema": {
            "additionalProperties": {},
            "type": "object"
          },
          "sideEffect": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "timeoutMs": {
            "type": "integer"
          }
        },
        "required": [
          "code",
          "name",
          "description",
          "contractVersion",
          "inputSchema",
          "outputSchema",
          "sideEffect",
          "idempotency",
          "timeoutMs",
          "status"
        ],
        "type": "object"
      },
      "StreamRequestInvokeReq": {
        "properties": {
          "idempotencyKey": {
            "description": "解码后的 UTF-8 字节数最多 128；是否必填由冻结合同决定",
            "type": "string"
          },
          "input": {}
        },
        "required": [
          "input"
        ],
        "type": "object"
      },
      "StreamRequestInvokeResp": {
        "properties": {
          "code": {
            "type": "string"
          },
          "contractVersion": {
            "description": "实际执行使用的冻结合同版本",
            "type": "string"
          },
          "replayed": {
            "description": "true=幂等重放，false=首次执行",
            "type": "boolean"
          },
          "result": {
            "description": "合同定义的 JSON 结果，允许 null"
          },
          "runID": {
            "description": "服务端返回的执行标识，不透明字符串",
            "type": "string"
          },
          "status": {
            "description": "服务端返回的终态，非 accepted/queued/pending/running",
            "type": "string"
          }
        },
        "required": [
          "code",
          "contractVersion",
          "result",
          "runID",
          "status",
          "replayed"
        ],
        "type": "object"
      },
      "StreamMessagesConnectReq": {
        "properties": {
          "appId": {
            "type": "string"
          },
          "clientPublicKey": {
            "type": "string"
          },
          "topics": {
            "items": {
              "$ref": "#/components/schemas/StreamMessageTopicPermission"
            },
            "type": "array"
          }
        },
        "required": [
          "appId",
          "clientPublicKey",
          "topics"
        ],
        "type": "object"
      },
      "StreamMessageTopicPermission": {
        "properties": {
          "publish": {
            "type": "boolean"
          },
          "subscribe": {
            "type": "boolean"
          },
          "topic": {
            "type": "string"
          }
        },
        "required": [
          "topic",
          "publish",
          "subscribe"
        ],
        "type": "object"
      },
      "StreamMessagesConnectResp": {
        "properties": {
          "contractVersion": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          },
          "maxPayloadBytes": {
            "type": "integer"
          },
          "permissions": {
            "items": {
              "$ref": "#/components/schemas/StreamMessageGrantedTopic"
            },
            "type": "array"
          },
          "url": {
            "type": "string"
          },
          "userJwt": {
            "type": "string"
          }
        },
        "required": [
          "contractVersion",
          "url",
          "userJwt",
          "expiresAt",
          "permissions",
          "maxPayloadBytes"
        ],
        "type": "object"
      },
      "StreamMessageGrantedTopic": {
        "properties": {
          "publishSubject": {
            "type": "string"
          },
          "subscribeSubject": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          }
        },
        "required": [
          "topic",
          "publishSubject",
          "subscribeSubject"
        ],
        "type": "object"
      },
      "PlatformCapabilityDiscoverResp": {
        "properties": {
          "apiContractVersions": {
            "description": "openapi/v1",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "capabilities": {
            "description": "只返回当前 Key 有授权摘要的已知能力，关闭的能力仍返回状态",
            "items": {
              "$ref": "#/components/schemas/PlatformPublicCapability"
            },
            "type": "array"
          },
          "contractVersion": {
            "description": "本发现响应合同版本，与单个 Stream request 的冻结合同版本独立",
            "type": "string"
          },
          "deprecations": {
            "items": {
              "$ref": "#/components/schemas/PlatformCapabilityDeprecation"
            },
            "type": "array"
          },
          "product": {
            "type": "string"
          },
          "productVersion": {
            "description": "仅返回显式配置的可信产品发布版本，未配置时省略",
            "type": "string"
          },
          "sdkContractVersions": {
            "description": "stream-requests/v1 公共 SDK 合同，不是 npm 版本",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "product",
          "contractVersion",
          "apiContractVersions",
          "sdkContractVersions",
          "capabilities",
          "deprecations"
        ],
        "type": "object"
      },
      "PlatformPublicCapability": {
        "properties": {
          "allowed": {
            "description": "当前 Key 的能力授权摘要，不替代具体 Stream request code 与读写权限检查",
            "type": "boolean"
          },
          "availability": {
            "description": "unavailable / unknown / available；不是设备在线或执行成功证明",
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "contractVersions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "enabled": {
            "description": "仅发布、实现和 readiness 均满足时为 true",
            "type": "boolean"
          },
          "releaseEnabled": {
            "description": "公开发布开关与当前 Workspace 灰度的交集，不表示 runtime 就绪",
            "type": "boolean"
          },
          "state": {
            "description": "disabled / not_supported / unavailable / readiness_unknown / ready",
            "type": "string"
          }
        },
        "required": [
          "code",
          "releaseEnabled",
          "enabled",
          "allowed",
          "state",
          "availability",
          "contractVersions"
        ],
        "type": "object"
      },
      "PlatformCapabilityDeprecation": {
        "properties": {
          "contract": {
            "type": "string"
          },
          "replacement": {
            "type": "string"
          },
          "sunsetAt": {
            "type": "string"
          }
        },
        "required": [
          "contract"
        ],
        "type": "object"
      },
      "PlatformCapabilityErrorResp": {
        "properties": {
          "errorCode": {
            "description": "INVALID_CREDENTIAL / CAPABILITY_INVALID_REQUEST / CAPABILITY_FORBIDDEN / CAPABILITY_UNAVAILABLE / CAPABILITY_INTERNAL_ERROR",
            "type": "string"
          },
          "message": {
            "description": "固定公开消息，不透传内部异常",
            "type": "string"
          }
        },
        "required": [
          "errorCode",
          "message"
        ],
        "type": "object"
      }
    }
  }
}
