  "source": "share/unscontract/manifest.json",
  "sourceManifestSHA256": "afc891d80f13d856b63343c371eac10849d11268b5c26bf6ea2368fa84ce7481",
  "scope": "Current Stream runtime/write DTOs, compiled message metadata and read-only history only; unrelated UNS data remains on its separately reviewed baseline.",
  "operationMetadata": {},
  "schemas": {
    "RuntimeStreamDefinition": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 512,
          "type": "string"
        },
        "extensions": {
          "additionalProperties": true,
          "type": "object"
        },
        "name": {
          "maxLength": 63,
          "minLength": 1,
          "type": "string"
        },
        "script": {
          "description": "Complete module.exports=api=>{...} program; uses api.source.use/api.uns.use/api.stream registration, not a transform function body",
          "maxLength": 131072,
          "minLength": 1,
          "type": "string",
          "writeOnly": true
        },
        "sdkVersion": {
          "enum": [
            "tier0-stream/v3"
          ],
          "type": "string"
        },
        "timeoutMs": {
          "default": 1000,
          "maximum": 60000,
          "minimum": 1,
          "type": "integer"
        },
        "sourceBindings": {
          "type": "array",
          "maxItems": 64,
          "description": "按 Source ID 唯一绑定当前修订和 Stream 采集参数；连接、认证和 TLS 仅从 Source 读取。HTTP acquisition 为 {}。native 写入目标由服务器冻结 selector/mapping 配置决定，不接受脚本 Capture。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "configRevision",
              "acquisition"
            ],
            "properties": {
              "sourceId": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$",
                "maxLength": 19
              },
              "configRevision": {
                "type": "integer",
                "minimum": 1
              },
              "acquisition": {
                "type": "object",
                "additionalProperties": true,
                "description": "协议专用采集参数，由 Source 协议校验；不得携带连接或凭据。"
              }
            }
          }
        }
      },
      "required": [
        "sdkVersion",
        "name",
        "script"
      ],
      "type": "object"
    },
    "CloudStreamScript": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sdkVersion": {
          "type": "string",
          "enum": [
            "tier0-stream/v3"
          ]
        },
        "code": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        }
      },
      "required": [
        "sdkVersion",
        "code",
        "timeoutMs"
      ]
    },
    "CloudStreamDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "maxLength": 512
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "script": {
          "$ref": "#/components/schemas/CloudStreamScript"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/CloudSourceBinding"
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/CloudStreamEntry"
          }
        },
        "messages": {
          "type": "array",
          "readOnly": true,
          "maxItems": 32,
          "description": "Declarations derived from the compiled release manifest; not current runtime readiness or authorization. Never contains physical broker subjects.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "topic",
              "access"
            ],
            "properties": {
              "topic": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,127}$"
              },
              "access": {
                "type": "string",
                "enum": [
                  "publish"
                ]
              }
            }
          }
        }
      },
      "required": [
        "name",
        "model",
        "script"
      ],
      "description": "Existing cloud deployment document, including script, frozen Source aliases and entries. Manage permission is required for full editor access. This is not an Enterprise shared transform."
    },
    "CloudStreamEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "additionalProperties": true
        },
        "request": {
          "$ref": "#/components/schemas/CloudControlDefinition"
        },
        "topic": {
          "type": "string",
          "readOnly": true,
          "description": "Logical subscription topic derived from the compiled business-message entry; not a physical broker subject."
        }
      },
      "required": [
        "id",
        "kind"
      ]
    },
    "UnsV2StreamProgramVersionsListResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "integer"
        },
        "msg": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "list",
            "total",
            "page",
            "size"
          ],
          "properties": {
            "list": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "streamId",
                  "versionId",
                  "release",
                  "status",
                  "digest",
                  "document",
                  "createdAt"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "streamId": {
                    "type": "string"
                  },
                  "versionId": {
                    "type": "string"
                  },
                  "release": {
                    "type": "integer"
                  },
                  "status": {
                    "type": "string"
                  },
                  "digest": {
                    "type": "string"
                  },
                  "createdAt": {
                    "type": "integer"
                  },
                  "document": {
                    "$ref": "#/components/schemas/CloudHistoricalStreamDocument",
                    "description": "只读历史 JSON：当前 stream.manage 可读取同一 release 的原始 DocumentJSON（包含旧 SDK/字段）；view 仅返回脱敏摘要。不得直接用于创建、验证、部署或恢复，也不代表运行时支持旧 SDK。"
                  }
                }
              }
            },
            "total": {
              "type": "integer"
            },
            "page": {
              "type": "integer"
            },
            "size": {
              "type": "integer"
            }
          }
        }
      },
      "required": [
        "code",
        "msg",
        "requestId",
        "data"
      ]
    },
    "CloudHistoricalStreamDocument": {
      "type": "object",
      "readOnly": true,
      "additionalProperties": true,
      "description": "Opaque immutable historical document or permission-redacted summary. Old SDK versions and retired metadata remain readable only here; this is never an active Stream write/runtime contract."
    }
  }
}
