{
  "name": "@tier0/sdk",
  "version": "0.5.4",
  "description": "Tier0 SDK - OpenAPI REST client and MQTT over WebSocket client for TypeScript/JavaScript",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    "./cloud": {
      "types": "./dist/esm/cloud.d.ts",
      "import": "./dist/esm/cloud.js",
      "require": "./dist/cjs/cloud.js"
    },
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./openapi": {
      "types": "./dist/esm/openapi/index.d.ts",
      "import": "./dist/esm/openapi/index.js",
      "require": "./dist/cjs/openapi/index.js"
    },
    "./openapi/react": {
      "types": "./dist/esm/openapi/react.d.ts",
      "import": "./dist/esm/openapi/react.js",
      "require": "./dist/cjs/openapi/react.js"
    },
    "./openapi/vue": {
      "types": "./dist/esm/openapi/vue.d.ts",
      "import": "./dist/esm/openapi/vue.js",
      "require": "./dist/cjs/openapi/vue.js"
    },
    "./files": {
      "types": "./dist/esm/files.d.ts",
      "import": "./dist/esm/files.js",
      "require": "./dist/cjs/files.js"
    },
    "./mq": {
      "types": "./dist/esm/mq/index.d.ts",
      "import": "./dist/esm/mq/index.js",
      "require": "./dist/cjs/mq/index.js"
    },
    "./cloud/server": {
      "types": "./dist/esm/cloud-server.d.ts",
      "import": "./dist/esm/cloud-server.js",
      "require": "./dist/cjs/cloud-server.js"
    }
  },
  "files": [
    "dist/",
    "skills/tier0-sdk/**"
  ],
  "agents": {
    "skills": [
      {
        "name": "tier0-sdk",
        "path": "./skills/tier0-sdk"
      },
      {
        "name": "tier0-sdk-uns",
        "path": "./skills/tier0-sdk/tier0-sdk-uns"
      },
      {
        "name": "tier0-sdk-mq",
        "path": "./skills/tier0-sdk/tier0-sdk-mq"
      },
      {
        "name": "tier0-sdk-flow",
        "path": "./skills/tier0-sdk/tier0-sdk-flow"
      },
      {
        "name": "tier0-sdk-files",
        "path": "./skills/tier0-sdk/tier0-sdk-files"
      },
      {
        "name": "tier0-sdk-members",
        "path": "./skills/tier0-sdk/tier0-sdk-members"
      },
      {
        "name": "tier0-sdk-notifications",
        "path": "./skills/tier0-sdk/tier0-sdk-notifications"
      },
      {
        "name": "tier0-sdk-system",
        "path": "./skills/tier0-sdk/tier0-sdk-system"
      }
    ]
  },
  "scripts": {
    "package:cloud-app": "node scripts/package-cloud-uns-app.mjs",
    "test:cloud-app": "node scripts/test-cloud-uns-app.mjs",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/finalize-build.mjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "generate": "bash scripts/generate-openapi.sh",
    "generate:stream-common": "node scripts/generate-stream-common.mjs",
    "check:stream-common-contract": "node scripts/generate-stream-common.mjs --check",
    "generate:uns-v2": "node scripts/generate-stream-common.mjs && node scripts/generate-uns-v2.mjs",
    "check:uns-v2-contract": "node scripts/generate-uns-v2.mjs --check",
    "typecheck": "tsc --noEmit && tsc --noEmit --strict --skipLibCheck --module nodenext --target es2020 tests/openapi/notifications.types.ts tests/openapi/controls.types.ts tests/openapi/capabilities.types.ts tests/openapi/uns-v2.types.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "sync:app-identity": "node scripts/sync-app-identity-contract.mjs"
  },
  "optionalDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "vue": "^3.4.0"
  },
  "dependencies": {
    "mqtt": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "openapi-typescript": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FREEZONEX/Tier0-sdk.git"
  },
  "keywords": [
    "tier0",
    "sdk",
    "openapi",
    "mqtt",
    "uns",
    "iot"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
